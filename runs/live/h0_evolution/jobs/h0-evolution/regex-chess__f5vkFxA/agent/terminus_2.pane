        for target,ov in targets:
            alts='|'.join(attack_alts(target,ov))
            full=r'(?m)^'+re.escape(side)+r'\|(?P<board>(?!(?:'+alts+r')).{64})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
            add(full,side+r'|\g<board>|\g<cast>|\g<ep>|\g<coords>')

def finalize_castles():
    add(r'(?m)^~RK\|(?P<pre>.{60})K11R\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$',
        r'~Ne1g1|\g<pre>1RK1|\g<cast>|\g<ep>|\g<coords>')
    add(r'(?m)^~RQ\|(?P<pre>.{56})R111K(?P<tail>.{3})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$',
        r'~Ne1c1|\g<pre>11KR1\g<tail>|\g<cast>|\g<ep>|\g<coords>')
    add(r'(?m)^~R[^\n]*\n?','')

def add_source_expansion():
    lines=[]
    for k in range(64):
        lines.append('~I'+sqn(k)+'@0|\\g<board>|\\g<cast>|\\g<ep>|\\g<coords>')
    repl='\n'.join(lines)
    pat=r'(?m)^~I(?P<board>.{64})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
    add(pat,repl)

def black_attack_alts(target, target_matcher='K'):
    tr,tf=divmod(target,8)
    alts=[]
    def make(src,matcher,path):
        b=['.']*64
        for p in path:
            b[p]='1'
        b[target]=target_matcher
        b[src]=matcher
        alts.append(''.join(b))
    for sf in (tf-1,tf+1):
        sr=tr-1
        if valid(sr,sf):
            make(sr*8+sf,'p',[])
    for dr,df in KN:
        sr,sf=tr-dr,tf-df
        if valid(sr,sf):
            make(sr*8+sf,'n',[])
    for dr,df in KG:
        sr,sf=tr-dr,tf-df
        if valid(sr,sf):
            make(sr*8+sf,'k',[])
    for dirs,matcher in ((DIAG,'[bq]'),(ORTH,'[rq]')):
        for dr,df in dirs:
            sr,sf=tr+dr,tf+df
            path=[]
            while valid(sr,sf):
                make(sr*8+sf,matcher,path)
                path.append(sr*8+sf)
                sr+=dr
                sf+=df
    return alts

def add_normal_attack_filter():
    nl=chr(10)
    for target in range(64):
        alts='|'.join(black_attack_alts(target,'K'))
        pat='(?m)^~N[^|]*[|](?:'+alts+')[|].*$'+nl+'?'
        add(pat,'')
