[?2004ldef board_pattern(items):
    # items: position -> (preboard_regex_token, replacement_string)
    its=sorted(items.items())
    pat=''; orig=''; moved=''; prev=-1
    for i,(p,(tok,new)) in enumerate(its):
        gap=p-prev-1
        pat += r'(?P<z%d>.{%d})(?P<v%d>%s)'%(i,gap,i,tok)
        orig += r'\g<z%d>\g<v%d>'%(i,i)
        moved += r'\g<z%d>%s'%(i,new)
        prev=p
    gap=63-prev
    pat += r'(?P<z%d>.{%d})'%(len(its),gap)
    orig += r'\g<z%d>'%len(its)
    moved += r'\g<z%d>'%len(its)
    return pat,orig,moved

def move_patterns(k,t):
    s=sqn(k); d=sqn(t); out=[]
    sr,sf=divmod(k,8); tr,tf=divmod(t,8)
    ar=abs(tr-sr); af=abs(tf-sf)
    def node(sm,tm,path=()):
        items={k:(sm,'1'),t:(tm,'1')}
        for p in path: items[p]=('1','1')
        pat,orig,moved=board_pattern(items)
        out.append((pat,orig,moved))
    if (ar,af) in KN:
        node('N','[1pnbrq]')
    if ar+af==1:
        node('[KQR]','[1pnbrq]')
    if ar==1 and af==1:
        node('[KQB]','[1pnbrq]')
    if ar==af and ar>=2:
        node('[BQ]','[1pnbrq]',clear_path(k,t))
    if (ar==0 and af>=2) or (af==0 and ar>=2):
        node('[RQ]','[1pnbrq]',clear_path(k,t))
    if sf==tf and tr==sr-1:
        node('P','Q' if tr==0 else '1')
    if sf==tf and sr==6 and tr==4:
        node('P','1',[k-8])
    if abs(tf-sf)==1 and tr==sr-1:
        node('P','Q' if tr==0 else '[pnbrq]')
    return out

def add_movement_patterns():
    for k in range(64):
        s=sqn(k)
        for t in range(64):
            d=sqn(t)
            for pat,orig,moved in move_patterns(k,t):
                full=r'(?m)^~I'+s+'@'+str(t)+r'\|'+pat+r'\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
                repl='~N'+s+d+'|'+moved+r'|\g<cast>|\g<ep>|\g<coords>\n~I'+s+'@'+str(t+1)+'|'+orig+r'|\g<cast>|\g<ep>|\g<coords>'
                add(full,repl)
            pat2=r'(?m)^~I'+s+'@'+str(t)+r'\|(?P<board>.{64})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
            repl2='~I'+s+'@'+str(t+1)+r'|\g<board>|\g<cast>|-|\g<coords>'
            add(pat2,repl2)

def add_ep_direct():
    for f in range(8):
        target=16+f; ept=chr(97+f)+'6'
        for sf in (f-1,f+1):
            if not (0<=sf<8): continue
            src=24+sf; cap=24+f
            items={src:('P','1'),target:('1','P'),cap:('p','1')}
            pat,orig,moved=board_pattern(items)
            s=sqn(src); d=sqn(target)
            full=r'(?m)^~I'+s+'@'+str(target)+r'\|'+pat+r'\|(?P<cast>[^|]*)\|'+ept+r'\|(?P<coords>.+)$'
            repl='~N'+s+d+'|'+moved+r'|\g<cast>|-|\g<coords>\n~I'+s+'@'+str(target+1)+'|'+orig+r'|\g<cast>|-|\g<coords>'
            # the next marker needs the old ep field; use a separate full pattern capturing ep
            full=r'(?m)^~I'+s+'@'+str(target)+r'\|'+pat+r'\|(?P<cast>[^|]*)\|(?P<ep>'+ept+r')\|(?P<coords>.+)$'
