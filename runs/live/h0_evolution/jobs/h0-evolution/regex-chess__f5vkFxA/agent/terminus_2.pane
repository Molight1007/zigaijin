def add_movement_patterns():
    for k in range(64):
        s=sqn(k)
        for t in range(64):
            d=sqn(t)
            for pat,orig,moved in move_patterns(k,t):
                full=r'(?m)^~I'+s+'@'+str(t)+r'\|'+pat+r'\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
                repl='~N'+s+d+'|'+moved+r'|\g<cast>|\g<ep>|\g<coords>\n~I'+s+'@'+str(t+1)+'|'+orig+r'|\g<cast>|\g<ep>|\g<coords>'
                add(full,repl)
            pat2=r'(?m)^~I'+s+'@'+str(t)+r'\|(?P<board>.{64})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
            repl2='~I'+s+'@'+str(t+1)+r'|\g<board>|\g<cast>|\g<ep>|\g<coords>'
            add(pat2,repl2)

def add_ep_direct():
    for f in range(8):
        target=16+f; ept=chr(97+f)+'6'
        for sf in (f-1,f+1):
            if not (0<=sf<8): continue
            src=24+sf; cap=24+f
            items={src:('P','1'),target:('1','P'),cap:('p','1')}
            pat,orig,moved=board_pattern(items)
            s=sqn(src); d=sqn(target)
            full=r'(?m)^~I'+s+'@'+str(target)+r'\|'+pat+r'\|(?P<cast>[^|]*)\|'+ept+r'\|(?P<coords>.+)$'
            repl='~N'+s+d+'|'+moved+r'|\g<cast>|-|\g<coords>\n~I'+s+'@'+str(target+1)+'|'+orig+r'|\g<cast>|\g<ep>|\g<coords>'
            # the next marker needs the old ep field; use a separate full pattern capturing ep
            full=r'(?m)^~I'+s+'@'+str(target)+r'\|'+pat+r'\|(?P<cast>[^|]*)\|(?P<ep>'+ept+r')\|(?P<coords>.+)$'
            repl='~N'+s+d+'|'+moved+r'|\g<cast>|-|\g<coords>\n~I'+s+'@'+str(target+1)+'|'+orig+r'|\g<cast>|\g<ep>|\g<coords>'
            add(full,repl)

def add_castling_generation():
    items={60:('K','1'),61:('1','R'),62:('1','K'),63:('R','1')}
    pat,orig,moved=board_pattern(items)
    full=r'(?m)^~Ie1@64\|'+pat+r'\|(?P<cast>(?=[^|]*K)[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
    add(full,'~RK|'+moved+r'|\g<cast>|\g<ep>|\g<coords>')
    items={56:('R','1'),57:('1','1'),58:('1','K'),59:('1','R'),60:('K','1')}
    pat,orig,moved=board_pattern(items)
    full=r'(?m)^~Ie1@64\|'+pat+r'\|(?P<cast>(?=[^|]*Q)[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
    add(full,'~RQ|'+moved+r'|\g<cast>|\g<ep>|\g<coords>')

DIAG_D=[(-1,-1),(-1,1),(1,-1),(1,1)]
ORTH_D=[(-1,0),(1,0),(0,-1),(0,1)]

def attack_alts(target,overrides=None):
    overrides=overrides or {}
    base=['.']*64
    targ=overrides.get(target,'K')
    alts=[]
    def make(src,matcher,path):
        b=base[:]
        for p in path: b[p]='1'
        for p,tok in overrides.items(): b[p]=tok
        b[target]=targ
        b[src]=matcher
        return ''.join(b)
    tr,tf=divmod(target,8)
    for sf in (tf-1,tf+1):
        sr=tr-1
        if valid(sr,sf): alts.append(make(sr*8+sf,'p',[]))
    for dr,df in KN:
        sr,sf=tr-dr,tf-df
        if valid(sr,sf): alts.append(make(sr*8+sf,'n',[]))
    for dr,df in KG:
        sr,sf=tr-dr,tf-df
        if valid(sr,sf): alts.append(make(sr*8+sf,'k',[]))
    for dirs,matcher in ((DIAG_D,'[bq]'),(ORTH_D,'[rq]')):
        for dr,df in dirs:
            sr,sf=tr+dr,tf+df; path=[]
            while valid(sr,sf):
                alts.append(make(sr*8+sf,matcher,path))
                path.append(sr*8+sf)
                sr+=dr; sf+=df
    return alts

def add_attack_filter(prefix,alt_sets):
    alts=[]
    for s in alt_sets:
        alts.extend(s)
    alts='|'.join(alts)
    pat=r'(?m)^'+prefix+r'(?P<rest>\|[^\n]*)$'
    # no-op placeholder; real patterns are made by caller

def add_castle_filters():
    for side,targets in (('~RK',[(60,{}),(61,{60:'[1K]'}),(62,{60:'[1K]',61:'1'})]),
                         ('~RQ',[(60,{}),(59,{60:'[1K]'}),(58,{60:'[1K]',59:'1'})])):
        for target,ov in targets:
            alts='|'.join(attack_alts(target,ov))
            full=r'(?m)^'+re.escape(side)+r'\|(?P<board>(?!(?:'+alts+r')).{64})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
            add(full,side+r'|\g<board>|\g<cast>|\g<ep>|\g<coords>')

def finalize_castles():
    add(r'(?m)^~RK\|(?P<pre>.{60})K11R\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$',
        r'~Ne1g1|\g<pre>1RK1|\g<cast>|\g<ep>|\g<coords>')
    add(r'(?m)^~RQ\|(?P<pre>.{56})R111K(?P<tail>.{3})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$',
        r'~Ne1c1|\g<pre>11KR1\g<tail>|\g<cast>|\g<ep>|\g<coords>')
    add(r'(?m)^~R[^\n]*\n?','')

def add_source_expansion():
    lines=[]
    for k in range(64):
        lines.append('~I'+sqn(k)+'@0|\\g<board>|\\g<cast>|\\g<ep>|\\g<coords>')
    repl='\n'.join(lines)
    pat=r'(?m)^~I(?P<board>.{64})\|(?P<cast>[^|]*)\|(?P<ep>[^|]*)\|(?P<coords>.+)$'
    add(pat,repl)
