[?2004limport json, re
P=[]
def add(p,r):
    P.append([p,r])
Z='0'*64
add(r'(?m)^(\S+) w (\S+) (\S+)[^\n]*$', r'~I\1|\2|\3|'+Z)
for d in '8765432':
    add(d,'1'*int(d))
add('/','')

def sqn(i):
    return chr(97+i%8)+str(8-i//8)
