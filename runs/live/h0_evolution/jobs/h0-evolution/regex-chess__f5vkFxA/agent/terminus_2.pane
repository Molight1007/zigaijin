python3 - <<'PY'
import json,re,chess
fen='rnbqkbnr/ppp1pppp/8/3pP3/8/8/PPPP1PPP/RNBQKBNR w KQkq d6 0 3'
patterns=json.load(open('/app/re.json'))
s=fen
for p,r in patterns: s=re.sub(p,r,s)
ours=[' '.join(x.split()[:4]) for x in s.split('\n') if x.strip()]
b=chess.Board(fen); exp=set()
for m in b.legal_moves:
 c=b.copy(); c.push(m); exp.add(' '.join(c.fen().split()[:4]))
print('our',len(ours),'exp',len(exp))
for x in sorted(set(ours)-exp): print('EXTRA',x)
for x in sorted(exp-set(ours)): print('MISS',x)
