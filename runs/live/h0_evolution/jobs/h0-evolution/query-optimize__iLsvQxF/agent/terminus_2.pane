[?2004l47 /app/sol.sql
WITH candidate_words AS (
  SELECT
    s.wordid,
    COUNT(DISTINCT s.synsetid) AS total_synsets,
    COUNT(*) AS total_senses,
    COUNT(DISTINCT syn.domainid) AS distinct_domains,
    COUNT(DISTINCT syn.posid) AS distinct_posids
  FROM senses s
  JOIN synsets syn ON syn.synsetid = s.synsetid
  GROUP BY s.wordid
  HAVING total_synsets >= 2
    AND distinct_domains >= 2
    AND total_senses >= 2
  ORDER BY
    total_senses DESC,
    total_synsets DESC,
    distinct_domains DESC,
    s.wordid ASC
  LIMIT 500
),
top_synset AS (
  SELECT
    s.wordid,
    s.synsetid,
    COUNT(*) AS sense_count,
    ROW_NUMBER() OVER (PARTITION BY s.wordid ORDER BY COUNT(*) DESC, s.synsetid ASC) AS rn
  FROM senses s
  JOIN candidate_words cw ON cw.wordid = s.wordid
  GROUP BY s.wordid, s.synsetid
)
SELECT
  cw.wordid AS word_id,
  w.word AS word,
  cw.total_synsets,
  cw.total_senses,
  cw.distinct_domains,
  cw.distinct_posids,
  ts.synsetid AS top_synsetid,
  ts.sense_count AS top_synset_sense_count
FROM candidate_words cw
JOIN words w ON w.wordid = cw.wordid
JOIN top_synset ts ON ts.wordid = cw.wordid AND ts.rn = 1
ORDER BY
  cw.total_senses DESC,
  cw.total_synsets DESC,
  cw.distinct_domains DESC,
  cw.wordid ASC;
