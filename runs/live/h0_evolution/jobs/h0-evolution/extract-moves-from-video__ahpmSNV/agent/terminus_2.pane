[?2004l[?2004h>     t=t.replace('_',' ')
[?2004l[?2004h>     t=re.sub(r'[^A-Za-z0-9, .\-]','',t)
[?2004l[?2004h>     t=re.sub(r'\s+',' ',t).strip().lower()
[?2004l[?2004h>     return t
[?2004l[?2004h> 
[?2004l[?2004h> def sim(a,b):
[?2004l[?2004h>     if not a or not b: return False
[?2004l[?2004h>     if a.startswith(b) or b.startswith(a): return True
[?2004l[?2004h>     if min(len(a),len(b))>=2 and difflib.SequenceMatcher(None,a,b).ratio() >= 0.6: return True
[?2004l[?2004h>     return False
