[?2004l(env-define global-env 'fgetchr prim-fgetchr)
(env-define global-env 'fputchr prim-fputchr)
(env-define global-env 'fdisplay prim-fdisplay)
(env-define global-env 'fread prim-fread)

(define (run-file-loop f)
  (let ((expr (prim-fread f)))
    (if (null? expr)
        (prim-fclose f)
        (progn
          (m-eval expr global-env)
          (run-file-loop f)))))

(define (run-file filename)
  (let ((f (prim-fopen filename "r")))
    (if (eq? f #f)
        '()
        (run-file-loop f))))

(define target-file (prim-read))
(run-file target-file)
