 echo "-- one-layer $n"; echo "/tmp/fact$n.scm" | timeout 5 python3 interp.py eval.scm; echo status:$?
 echo "-- nested $n"; { echo eval.scm; echo "/tmp/fact$n.scm"; } | timeout 5 python3 interp.py eval.scm; echo status:$?
done
