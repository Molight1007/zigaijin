[?2004l[?2004h>         details = subprocess.check_output(
[?2004l[?2004h>             ['openssl', 'x509', '-in', CERT_FILE, '-noout', '-subject', '-enddate', '-nameopt', 'RFC2253'],
[?2004l[?2004h>             text=True,
