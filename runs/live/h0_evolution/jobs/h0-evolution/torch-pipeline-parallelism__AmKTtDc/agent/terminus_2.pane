    22	def _make_causal_mask(base_model, hidden_states, cache_position, dtype, device):
    23	    if hasattr(base_model, '_update_causal_mask'):
    24	        try:
    25	            return base_model._update_causal_mask(
    26	                None, hidden_states, cache_position, None, False
    27	            )
    28	        except Exception:
    29	            pass
    30	
    31	    seq_len = hidden_states.size(1)
    32	    mask = torch.full(
    33	        (seq_len, seq_len),
    34	        torch.finfo(dtype).min,
    35	        dtype=dtype,
    36	        device=device,
    37	    )
    38	    mask = torch.triu(mask, diagonal=1)
    39	    return mask.unsqueeze(0).unsqueeze(0)
