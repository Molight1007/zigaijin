     7	def _call_with_supported_kwargs(fn, *args, **kwargs):
     8	    try:
     9	        signature = inspect.signature(fn)
    10	    except (TypeError, ValueError):
    11	        return fn(*args, **kwargs)
    12	
    13	    parameters = signature.parameters
    14	    accepts_kwargs = any(
    15	        p.kind == inspect.Parameter.VAR_KEYWORD for p in parameters.values()
    16	    )
    17	    if not accepts_kwargs:
    18	        kwargs = {k: v for k, v in kwargs.items() if k in parameters}
    19	    return fn(*args, **kwargs)
