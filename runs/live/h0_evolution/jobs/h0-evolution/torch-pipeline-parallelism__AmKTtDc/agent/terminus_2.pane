   120	        seq_len = h.size(1)
   121	        cache_position = torch.arange(seq_len, device=device)
   122	        position_ids = cache_position.unsqueeze(0).expand(h.size(0), -1)
   123	        causal_mask = _make_causal_mask(
   124	            base_model, h, cache_position, dtype, device
   125	        )
   126	
   127	        position_embeddings = None
   128	        if supports_position_embeddings:
