    42	def train_step_pipeline_afab(model, inputs, targets, device, dtype):
    43	    device = torch.device(device)
    44	    rank = dist.get_rank()
    45	    world_size = dist.get_world_size()
    46	    num_microbatches = len(inputs)
    47	
    48	    model.to(device=device, dtype=dtype)
    49	
    50	    if world_size == 1:
    51	        total_loss = None
    52	        for i in range(num_microbatches):
    53	            input_ids = inputs[i].to(device=device, dtype=torch.long)
    54	            target_ids = targets[i].to(device=device, dtype=torch.long)
    55	            output = model(
    56	                input_ids=input_ids,
    57	                labels=target_ids,
    58	                use_cache=False,
    59	            )
    60	            loss = output.loss
    61	            if total_loss is None:
    62	                total_loss = loss
    63	            else:
    64	                total_loss = total_loss + loss
    65	        (total_loss / num_microbatches).backward()
    66	        return
    67	
    68	    if rank == 0:
