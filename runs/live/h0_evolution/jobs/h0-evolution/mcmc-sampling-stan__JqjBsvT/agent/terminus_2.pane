parameters {
  real<lower=0> alpha;
  real<lower=0> beta;
  real<lower=0, upper=1> theta[N];
}

model {
  target += -2.5 * log(alpha + beta);
  theta ~ beta(alpha, beta);
  y ~ binomial(n, theta);
}
