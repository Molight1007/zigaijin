[?2004hroot@9e1ade6d9569:/app# cat /app/analysis.R
[?2004llibrary(rstan)

rstan_options(auto_write = TRUE)
options(mc.cores = 4)

dat <- read.csv('/app/data.csv')
stan_data <- list(N = nrow(dat), y = dat$y, n = dat$n)

fit <- stan(
  file = '/app/hierarchical_model.stan',
  data = stan_data,
  chains = 4,
  iter = 100000,
  seed = 1,
  cores = 4,
  refresh = 0
)

posterior <- extract(fit)
alpha_mean <- mean(posterior$alpha)
beta_mean <- mean(posterior$beta)

writeLines(sprintf('%.10f', alpha_mean), '/app/posterior_alpha_mean.txt')
writeLines(sprintf('%.10f', beta_mean), '/app/posterior_beta_mean.txt')

cat('Posterior mean alpha:', alpha_mean, '\n')
cat('Posterior mean beta:', beta_mean, '\n')
[?2004hroot@9e1ade6d9569:/app# cat /app/hierarchical_model.stan
[?2004ldata {
