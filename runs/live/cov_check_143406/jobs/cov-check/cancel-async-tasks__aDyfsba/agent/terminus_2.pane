[?2004l[?2004h> 
[?2004l[?2004h> async def run_tasks(
[?2004l[?2004h>     tasks: list[Callable[[], Awaitable[None]]],
[?2004l[?2004h>     max_concurrent: int,
[?2004l[?2004h> ) -> None:
[?2004l[?2004h>     '''Run async tasks with a maximum concurrency limit.
[?2004l[?2004h> 
[?2004l[?2004h>     If the caller is cancelled, all running tasks are cancelled and awaited so
[?2004l[?2004h>     their cleanup code can run before cancellation is re-raised.
[?2004l[?2004h>     '''
[?2004l[?2004h>     if max_concurrent < 1:
[?2004l[?2004h>         raise ValueError('max_concurrent must be at least 1')
[?2004l[?2004h> 
[?2004l[?2004h>     semaphore = asyncio.Semaphore(max_concurrent)
[?2004l[?2004h> 
[?2004l[?2004h>     async def run_one(task: Callable[[], Awaitable[None]]) -> None:
[?2004l[?2004h>         async with semaphore:
[?2004l[?2004h>             await task()
[?2004l[?2004h> 
[?2004l[?2004h>     running = [asyncio.create_task(run_one(task)) for task in tasks]
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         await asyncio.gather(*running)
[?2004l[?2004h>     except BaseException:
[?2004l[?2004h>         for task in running:
[?2004l[?2004h>             task.cancel()
[?2004l[?2004h>         await asyncio.gather(*running, return_exceptions=True)
[?2004l[?2004h>         raise
