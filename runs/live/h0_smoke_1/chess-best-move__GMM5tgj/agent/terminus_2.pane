[?2004hroot@7a4d58a897f3:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load(); light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> def sil(r,f,S=24,T=24,thr=40):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     pts=set()
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: pts.add((x,y))
[?2004l[?2004h>     minx=min(x for x,y in pts); miny=min(y for x,y in pts)
[?2004l[?2004h>     pts={(x-minx,y-miny) for x,y in pts}; mx=max(x for x,y in pts); my=max(y for x,y in pts)
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for j in range(T):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for i in range(S):
[?2004l[?2004h>             xa=i*(mx+1)//S; xb=max(xa+1,(i+1)*(mx+1)//S); ya=j*(my+1)//T; yb=max(ya+1,(j+1)*(my+1)//T)
[?2004l[?2004h>             c=sum(1 for y in range(ya,yb) for x in range(xa,xb) if (x,y) in pts); n=(xb-xa)*(yb-ya)
[?2004l[?2004h>             line += '#' if c/n>0.3 else ('+' if c/n>0.08 else '.')
[?2004l[?2004h>         out.append(line)
[?2004l[?2004h>     return out
[?2004l[?2004h> names=[('c6',2,2),('b7',1,1),('c8',0,2)]
[?2004l[?2004h> sils=[sil(r,f) for _,r,f in names]
[?2004l[?2004h> print('   '.join(f'{n:^24}' for n,_,_ in names))
[?2004l[?2004h> for j in range(24): print('   '.join(s[j] for s in sils))
