[?2004hroot@7a4d58a897f3:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load(); light=(240,217,181); dark=(181,136,99); files='abcdefgh'
[?2004l[?2004h> def stats(name,r,f,thr=45):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     S=set()
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: S.add((x,y))
[?2004l[?2004h>     if not S: return
[?2004l[?2004h>     xs=[x for x,y in S]; ys=[y for x,y in S]
[?2004l[?2004h>     minx,maxx,miny,maxy=min(xs),max(xs),min(ys),max(ys)
[?2004l[?2004h>     w=maxx-minx+1; h=maxy-miny+1
[?2004l[?2004h>     norm={(x-minx,y-miny) for x,y in S}
[?2004l[?2004h>     flip={ (w-1-x,y) for x,y in norm}
[?2004l[?2004h>     sym=len(norm&flip)/len(norm|flip)
[?2004l[?2004h>     # top mask occupancy by rows (normalized)
[?2004l[?2004h>     profile=[]
[?2004l[?2004h>     for yy in range(h):
[?2004l[?2004h>         profile.append(sum(1 for x,y in norm if y==yy))
[?2004l[?2004h>     topwidth=max(profile[:max(1,h//5)]) if h else 0
[?2004l[?2004h>     botwidth=max(profile[-max(1,h//5):]) if h else 0
[?2004l[?2004h>     print(f'{name:>3} n={len(S):4d} bbox={w:2d}x{h:2d} sym={sym:.2f} topmax={topwidth:2d} botmax={botwidth:2d} centroid=({sum(x for x,y in norm)/len(norm):.1f}},{sum(y for x,y in norm)/len(norm):.1f})')
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         stats(f'{files[f]}{8-r}',r,f)
