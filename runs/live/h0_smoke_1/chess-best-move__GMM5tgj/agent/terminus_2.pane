[?2004hroot@7a4d58a897f3:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load(); light=(240,217,181); dark=(181,136,99); files='abcdefgh'
[?2004l[?2004h> def masksq(r,f,thr=40):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     pts=set()
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: pts.add((x,y))
[?2004l[?2004h>     return pts
[?2004l[?2004h> squares=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         p=masksq(r,f)
[?2004l[?2004h>         if len(p)>50:
[?2004l[?2004h>             xs=[x for x,y in p]; ys=[y for x,y in p]
[?2004l[?2004h>             m=(min(xs),min(ys))
[?2004l[?2004h>             norm=set((x-m[0],y-m[1]) for x,y in p)
[?2004l[?2004h>             squares.append([f'{files[f]}{8-r}',r,f,len(p),norm])
[?2004l[?2004h> par=list(range(len(squares)))
[?2004l[?2004h> def find(a):
[?2004l[?2004h>     while par[a]!=a: par[a]=par[par[a]]; a=par[a]
[?2004l[?2004h>     return a
[?2004l[?2004h> def uni(a,b):
[?2004l[?2004h>     a,b=find(a),find(b)
[?2004l[?2004h>     if a!=b: par[b]=a
[?2004l[?2004h> for i in range(len(squares)):
[?2004l[?2004h>     for j in range(i):
[?2004l[?2004h>         A=squares[i][4]; B=squares[j][4]
[?2004l[?2004h>         J=len(A&B)/len(A|B)
[?2004l[?2004h>         if J>0.80: uni(i,j)
[?2004l[?2004h> g=defaultdict(list)
[?2004l[?2004h> for i,s in enumerate(squares): g[find(i)].append(s)
[?2004l[?2004h> for gi,grp in enumerate(g.values()):
[?2004l[?2004h>     grp.sort(key=lambda s:-s[3])
[?2004l[?2004h>     print('GROUP',gi,':')
[?2004l[?2004h>     print('  members:',', '.join(f'{s[0]}({s[3]})' for s in grp))
[?2004l[?2004h>     S=grp[0][4]; maxx=max(x for x,y in S); maxy=max(y for x,y in S)
[?2004l[?2004h>     W=16; H=16
[?2004l[?2004h>     for j in range(H):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for i in range(W):
[?2004l[?2004h>             x0=i*(maxx+1)//W; x1=(i+1)*(maxx+1)//W; y0=j*(maxy+1)//H; y1=(j+1)*(maxy+1)//H
[?2004l[?2004h>             cnt=sum(1 for y in range(y0,y1) for x in range(x0,x1) if (x,y) in S)
[?2004l[?2004h>             tot=max(1,(x1-x0)*(y1-y0))
[?2004l[?2004h>             line += '#' if cnt/tot>0.35 else ('+' if cnt/tot>0.12 else '.')
[?2004l[?2004h>         print(' ',line)
[?2004l[?2004h> PY
