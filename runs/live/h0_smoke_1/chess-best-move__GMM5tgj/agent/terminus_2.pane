[?2004hroot@7a4d58a897f3:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load(); light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> def show(name,r,f,W=24,H=20,thr=35):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     S=set()
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: S.add((x,y))
[?2004l[?2004h>     minx=min(x for x,y in S); miny=min(y for x,y in S)
[?2004l[?2004h>     S={(x-minx,y-miny) for x,y in S}; maxx=max(x for x,y in S); maxy=max(y for x,y in S)
[?2004l[?2004h>     print(f'--- {name} bbox {maxx+1}x{maxy+1} ---')
[?2004l[?2004h>     for j in range(H):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for i in range(W):
[?2004l[?2004h>             xa=i*(maxx+1)//W; xb=max(xa+1,(i+1)*(maxx+1)//W)
[?2004l[?2004h>             ya=j*(maxy+1)//H; yb=max(ya+1,(j+1)*(maxy+1)//H)
[?2004l[?2004h>             cnt=sum(1 for y in range(ya,yb) for x in range(xa,xb) if (x,y) in S)
[?2004l[?2004h>             frac=cnt/((xb-xa)*(yb-ya))
[?2004l[?2004h>             line += '#' if frac>0.25 else ('+' if frac>0.08 else '.')
[?2004l[?2004h>         print(line)
[?2004l[?2004h> for name,r,f in [('a1',7,0),('c1',7,2),('e1',7,4),('h1',7,7),('b2',6,1),('e2',6,4),('f2',6,5),('g2',6,6),('a3',5,0),('c3',5,2),('e5',3,4),('h5',3,7)]:
[?2004l[?2004h>     show(name,r,f)
