[?2004hroot@7a4d58a897f3:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load()
[?2004l[?2004h> light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> files='abcdefgh'
[?2004l[?2004h> 
[?2004l[?2004h> def mask(r,f,thr=30):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     pts=[]
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr:
[?2004l[?2004h>                 pts.append((x,y))
[?2004l[?2004h>     return pts
[?2004l[?2004h> 
[?2004l[?2004h> squares=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         pts=mask(r,f)
[?2004l[?2004h>         if len(pts)>50:
[?2004l[?2004h>             xs=[p[0] for p in pts]; ys=[p[1] for p in pts]
[?2004l[?2004h>             minx,maxx=min(xs),max(xs); miny,maxy=min(ys),max(ys)
[?2004l[?2004h>             norm=set((x-minx,y-miny) for x,y in pts)
[?2004l[?2004h>             squares.append((f'{files[f]}{8-r}',r,f,len(pts),(minx,miny,maxx,maxy),norm))
[?2004l[?2004h> 
[?2004l[?2004h> # union bounding boxes and jaccard
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> parent=list(range(len(squares)))
[?2004l[?2004h> def find(a):
[?2004l[?2004h>     while parent[a]!=a:
[?2004l[?2004h>         parent[a]=parent[parent[a]]; a=parent[a]
[?2004l[?2004h>     return a
[?2004l[?2004h> def union(a,b):
[?2004l[?2004h>     ra,rb=find(a),find(b)
[?2004l[?2004h>     if ra!=rb: parent[rb]=ra
[?2004l[?2004h> 
[?2004l[?2004h> for i in range(len(squares)):
[?2004l[?2004h>     for j in range(i):
[?2004l[?2004h>         A=squares[i]; B=squares[j]
[?2004l[?2004h>         # align by bounding box top-left (shape normalized)
[?2004l[?2004h>         sa=set(A[5]); sb=set(B[5])
[?2004l[?2004h>         inter=len(sa&sb); uni=len(sa|sb)
[?2004l[?2004h>         if inter/uni>0.75:
[?2004l[?2004h>             union(i,j)
[?2004l[?2004h> 
[?2004l[?2004h> groups=defaultdict(list)
[?2004l[?2004h> for i,s in enumerate(squares): groups[find(i)].append(s)
[?2004l[?2004h> for gi,g in enumerate(groups.values()):
[?2004l[?2004h>     g.sort(key=lambda x:-x[3])
[?2004l[?2004h>     members=','.join(s[0] for s in g)
[?2004l[?2004h>     print(f'GROUP {gi}: {members}  counts={[s[3] for s in g]}')
[?2004l[?2004h>     s=g[0]; norm=s[5]
[?2004l[?2004h>     maxx=max(p[0] for p in norm); maxy=max(p[1] for p in norm)
[?2004l[?2004h>     for y in range(maxy+1):
[?2004l[?2004h>         line=''
