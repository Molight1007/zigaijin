[?2004hroot@7a4d58a897f3:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load(); light=(240,217,181); dark=(181,136,99); files='abcdefgh'
[?2004l[?2004h> def mask(r,f,thr=40):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     pts=set()
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: pts.add((x,y))
[?2004l[?2004h>     return pts
[?2004l[?2004h> reps=[('c6',2,2),('a8',0,0),('a6',2,0),('f8',0,5),('b7',1,1),('d8',0,3),('f5',3,5),('c8',0,2),('e2',6,4),('a1',7,0),('c3',5,2),('e1',7,4),('h1',7,7),('c1',7,2)),('a3',5,0),('e5',3,4)]
[?2004l[?2004h> for name,r,f in reps:
[?2004l[?2004h>     S=mask(r,f); minx=min(x for x,y in S); miny=min(y for x,y in S)
[?2004l[?2004h>     S={(x-minx,y-miny) for x,y in S}; maxx=max(x for x,y in S); maxy=max(y for x,y in S)
[?2004l[?2004h>     print(f'--- {name} bbox {maxx+1}x{maxy+1} n={len(S)} ---')
[?2004l[?2004h>     W=22; H=18
[?2004l[?2004h>     for j in range(H):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for i in range(W):
[?2004l[?2004h>             x0=i*(maxx+1)//W; x1=max(x0+1,(i+1)*(maxx+1)//W)
[?2004l[?2004h>             y0=j*(maxy+1)//H; y1=max(y0+1,(j+1)*(maxy+1)//H)
[?2004l[?2004h>             cnt=sum(1 for y in range(y0,y1) for x in range(x0,x1) if (x,y) in S)
[?2004l[?2004h>             tot=(x1-x0)*(y1-y0)
[?2004l[?2004h>             line += '#' if cnt/tot>0.35 else ('+' if cnt/tot>0.12 else '.')
[?2004l[?2004h>         print(line)
[?2004l[?2004h> PY
