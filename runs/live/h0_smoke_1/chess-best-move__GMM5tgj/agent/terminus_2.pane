[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load()
[?2004l[?2004h> light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> files='abcdefgh'
[?2004l[?2004h> def square_ascii(r,f,S=16):
[?2004l[?2004h>     x0=f*80; y0=r*80
[?2004l[?2004h>     bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     lines=[]
[?2004l[?2004h>     for j in range(S):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for i in range(S):
[?2004l[?2004h>             cnt=0; wcnt=0
[?2004l[?2004h>             for y in range(y0+j*80//S, y0+(j+1)*80//S):
[?2004l[?2004h>                 for x in range(x0+i*80//S, x0+(i+1)*80//S):
[?2004l[?2004h>                     p=px[x,y]
[?2004l[?2004h>                     d=sum((p[k]-bg[k])**2 for k in range(3))
[?2004l[?2004h>                     if d>30*30: cnt+=1
[?2004l[?2004h>                     lum=0.299*p[0]+0.587*p[1]+0.114*p[2]
[?2004l[?2004h>                     if lum>220 and max(p)-min(p)<25: wcnt+=1
[?2004l[?2004h>             line += '#' if cnt>=3 else ('O' if wcnt>=3 else '.')
[?2004l[?2004h>         lines.append(line)
[?2004l[?2004h>     return lines
[?2004l[?2004h> for rank,baserow in [('1',7),('2',6)]:
[?2004l[?2004h>     print('RANK',rank)
[?2004l[?2004h>     squares=[square_ascii(baserow,f) for f in range(8)]
[?2004l[?2004h>     print('  '.join(f'{files[f]}{rank}'.center(16) for f in range(8)))
[?2004l[?2004h>     for j in range(16):
[?2004l[?2004h>         print('  '.join(s[j] for s in squares))
