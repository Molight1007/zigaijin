[?2004l[?2004h> def show(name,r,f,S=32,T=24):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     print('===',name,'===')
[?2004l[?2004h>     for j in range(T):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for i in range(S):
[?2004l[?2004h>             occ=dc=wc=0
[?2004l[?2004h>             for y in range(y0+j*80//T,y0+(j+1)*80//T):
[?2004l[?2004h>                 for x in range(x0+i*80//S,x0+(i+1)*80//S):
[?2004l[?2004h>                     p=px[x,y]
[?2004l[?2004h>                     d=sum((p[k]-bg[k])**2 for k in range(3))
[?2004l[?2004h>                     lum=0.299*p[0]+0.587*p[1]+0.114*p[2]
[?2004l[?2004h>                     if d>30*30:
[?2004l[?2004h>                         occ+=1
[?2004l[?2004h>                         if lum<80: dc+=1
[?2004l[?2004h>                         if lum>235 and max(p)-min(p)<20: wc+=1
[?2004l[?2004h>             if wc>=3: line+='O'
[?2004l[?2004h>             elif dc>=3: line+='#'
[?2004l[?2004h>             elif occ>=3: line+='+'
[?2004l[?2004h>             else: line+='.'
[?2004l[?2004h>         print(line)
[?2004l[?2004h> for name,r,f in [('c8',0,2),('d8',0,3),('c6',2,2)]:
[?2004l[?2004h>     show(name,r,f)
