[?2004l[?2004h> def mask(r,f,thr=45):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     pts=set()
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: pts.add((x,y))
[?2004l[?2004h>     if not pts: return None
[?2004l[?2004h>     minx=min(x for x,y in pts); miny=min(y for x,y in pts)
[?2004l[?2004h>     return set((x-minx,y-miny) for x,y in pts)
[?2004l[?2004h> sq=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         m=mask(r,f)
[?2004l[?2004h>         if m and len(m)>60:
[?2004l[?2004h>             sq.append((f'{files[f]}{8-r}',r,f,len(m),m))
[?2004l[?2004h> # same-color grouping labels from previous run-ish: just print all top pairs
[?2004l[?2004h> pairs=[]
[?2004l[?2004h> for i in range(len(sq)):
[?2004l[?2004h>     for j in range(i):
[?2004l[?2004h>         A=sq[i][4]; B=sq[j][4]
[?2004l[?2004h>         J=len(A&B)/len(A|B)
[?2004l[?2004h>         pairs.append((J,sq[i][0],sq[j][0],sq[i][3],sq[j][3]))
[?2004l[?2004h> for J,a,b,na,nb in sorted(pairs, reverse=True)[:50]:
[?2004l[?2004h>     print(f'{J:.3f} {a:>3} {b:>3} n={na},{nb}')
