[?2004l[?2004h> def shape(name,r,f,W=36,H=26,thr=45):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     S=set()
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: S.add((x,y))
[?2004l[?2004h>     minx=min(x for x,y in S); miny=min(y for x,y in S); S={(x-minx,y-miny) for x,y in S}
[?2004l[?2004h>     maxx=max(x for x,y in S); maxy=max(y for x,y in S)
[?2004l[?2004h>     print(f'--- {name} ---')
[?2004l[?2004h>     for j in range(H):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         xa=0; xb=maxx+1
[?2004l[?2004h>         ya=j*(maxy+1)//H; yb=max(ya+1,(j+1)*(maxy+1)//H)
[?2004l[?2004h>         for i in range(W):
[?2004l[?2004h>             xa=i*(maxx+1)//W; xb=max(xa+1,(i+1)*(maxx+1)//W)
[?2004l[?2004h>             cnt=sum(1 for y in range(ya,yb) for x in range(xa,xb) if (x,y) in S)
[?2004l[?2004h>             frac=cnt/((xb-xa)*(yb-ya))
[?2004l[?2004h>             line += '#' if frac>0.3 else ('+' if frac>0.1 else '.')
[?2004l[?2004h>         print(line)
[?2004l[?2004h> for n,r,f in [('e1',7,4),('e2',6,4),('d8',0,3),('f5',3,5)]: shape(n,r,f)
