[?2004l[?2004h>                     if lum<80: black+=1
[?2004l[?2004h>                     elif lum>220 and max(p)-min(p)<25: white+=1
[?2004l[?2004h>                     else: other+=1
[?2004l[?2004h>         tot=black+white+other
[?2004l[?2004h>         if tot>20:
[?2004l[?2004h>             sq=f'{files[f]}{8-r}'
[?2004l[?2004h>             typ='B' if black>white else 'W'
[?2004l[?2004h>             print(f'{sq}: bg={bgc:4d} black={black:4d} white={white:4d} other={other:4d} -> {typ}')
