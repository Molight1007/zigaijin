[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load()
[?2004l[?2004h> light=(240,217,181); dark=(181,136,99)
[?2004l[?2004h> files='abcdefgh'
[?2004l[?2004h> def ascii_piece(r,f,S=28):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for j in range(S):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for i in range(S):
[?2004l[?2004h>             darkcnt=0; whitecnt=0; occ=0
[?2004l[?2004h>             for y in range(y0+j*80//S,y0+(j+1)*80//S):
[?2004l[?2004h>                 for x in range(x0+i*80//S,x0+(i+1)*80//S):
[?2004l[?2004h>                     p=px[x,y]
[?2004l[?2004h>                     d=sum((p[k]-bg[k])**2 for k in range(3))
[?2004l[?2004h>                     lum=0.299*p[0]+0.587*p[1]+0.114*p[2]
[?2004l[?2004h>                     if d>25*25:
[?2004l[?2004h>                         occ+=1
[?2004l[?2004h>                         if lum<80: darkcnt+=1
[?2004l[?2004h>                         if lum>235 and max(p)-min(p)<20: whitecnt+=1
[?2004l[?2004h>             if whitecnt>=4: line+='O'
[?2004l[?2004h>             elif darkcnt>=4: line+='#'
[?2004l[?2004h>             elif occ>=4: line+='+'
[?2004l[?2004h>             else: line+='.'
[?2004l[?2004h>         out.append(line)
[?2004l[?2004h>     return out
[?2004l[?2004h> white_squares=[('a1',7,0),('c1',7,2),('e1',7,4),('h1',7,7),('b2',6,1),('e2',6,4),('f2',6,5),('g2',6,6),('a3',5,0),('c3',5,2),('e5',3,4),('h5',3,7)]
[?2004l[?2004h> for name,r,f in white_squares:
[?2004l[?2004h>     print('===',name,'===')
[?2004l[?2004h>     for ln in ascii_piece(r,f): print(ln)
