[?2004hroot@7a4d58a897f3:/app# python3 - <<'PY'
[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> px=im.load(); light=(240,217,181); dark=(181,136,99); files='abcdefgh'
[?2004l[?2004h> def masksq(r,f,thr=45):
[?2004l[?2004h>     x0=f*80; y0=r*80; bg=light if (r+f)%2==0 else dark
[?2004l[?2004h>     pts=[]
[?2004l[?2004h>     for y in range(80):
[?2004l[?2004h>         for x in range(80):
[?2004l[?2004h>             p=px[x0+x,y0+y]
[?2004l[?2004h>             if sum((p[k]-bg[k])**2 for k in range(3))>thr*thr: pts.append((x,y))
[?2004l[?2004h>     return pts
[?2004l[?2004h> squares=[]
[?2004l[?2004h> for r in range(8):
[?2004l[?2004h>     for f in range(8):
[?2004l[?2004h>         pts=masksq(r,f)
[?2004l[?2004h>         if len(pts)>60:
[?2004l[?2004h>             xs=[p[0] for p in pts]; ys=[p[1] for p in pts]
[?2004l[?2004h>             minx,maxx,miny,maxy=min(xs),max(xs),min(ys),max(ys)
[?2004l[?2004h>             norm=set((x-minx,y-miny) for x,y in pts)
[?2004l[?2004h>             squares.append({'name':f'{files[f]}{8-r}','r':r,'f':f,'n':len(pts),'norm':norm,'bb':(maxx-minx+1,maxy-miny+1)})
[?2004l[?2004h> par=list(range(len(squares)))
[?2004l[?2004h> def find(a):
[?2004l[?2004h>     while par[a]!=a: par[a]=par[par[a]]; a=par[a]
[?2004l[?2004h>     return a
[?2004l[?2004h> def uni(a,b):
[?2004l[?2004h>     a,b=find(a),find(b)
[?2004l[?2004h>     if a!=b: par[b]=a
[?2004l[?2004h> for i in range(len(squares)):
[?2004l[?2004h>     for j in range(i):
[?2004l[?2004h>         A=squares[i]['norm']; B=squares[j]['norm']
[?2004l[?2004h>         inter=len(A&B); uni_n=len(A|B)
[?2004l[?2004h>         if inter/uni_n>0.82: uni(i,j)
[?2004l[?2004h> g=defaultdict(list)
[?2004l[?2004h> for i,s in enumerate(squares): g[find(i)].append(s)
[?2004l[?2004h> lines=[]
[?2004l[?2004h> for gi,grp in enumerate(sorted(g.values(), key=lambda v: -max(x['n'] for x in v))):
[?2004l[?2004h>     grp.sort(key=lambda s:-s['n'])
[?2004l[?2004h>     lines.append(f"GROUP {gi}: " + ', '.join(f"{s['name']}(n={s['n']},bb={s['bb'][0]}x{s['bb'][1]})" for s in grp))
[?2004l[?2004h> open('/tmp/piece_groups.txt','w').write('\n'.join(lines)+'\n')
[?2004l[?2004h> print('\n'.join(lines))
[?2004l[?2004h> PY
