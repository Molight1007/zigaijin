[?2004l[?2004h> from PIL import Image, ImageFont, ImageDraw
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> fpath='/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf'
[?2004l[?2004h> black_chars={'K':'\u265a','Q':'\u265b','R':'\u265c','B':'\u265d','N':'\u265e','P':'\u265f'}
[?2004l[?2004h> white_chars={'K':'\u2654','Q':'\u2655','R':'\u2656','B':'\u2657','N':'\u2658','P':'\u2659'}
[?2004l[?2004h> 
[?2004l[?2004h> def glyph_mask(ch,size):
[?2004l[?2004h>     f=ImageFont.truetype(fpath,size)
[?2004l[?2004h>     img=Image.new('L',(200,200),0)
[?2004l[?2004h>     ImageDraw.Draw(img).text((20,20),ch,font=f,fill=255)
[?2004l[?2004h>     bb=img.getbbox()
[?2004l[?2004h>     if not bb: return None
[?2004l[?2004h>     return img.crop(bb)
[?2004l[?2004h> 
[?2004l[?2004h> def obs_mask(name):
[?2004l[?2004h>     c=ord(name[0])-97; r=8-int(name[1])
[?2004l[?2004h>     sq=im.crop((c*80,r*80,(c+1)*80,(r+1)*80))
[?2004l[?2004h>     black=sum(1 for p in sq.getdata() if max(p)<120)
[?2004l[?2004h>     white=sum(1 for p in sq.getdata() if min(p)>240)
[?2004l[?2004h>     if black>white:
[?2004l[?2004h>         color='B'; pts=[(x,y) for y in range(80) for x in range(80) if max(sq.getpixel((x,y)))<130]
[?2004l[?2004h>     else:
[?2004l[?2004h>         color='W'; pts=[(x,y) for y in range(80) for x in range(80) if min(sq.getpixel((x,y)))>220]
[?2004l[?2004h>     minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)
[?2004l[?2004h>     m=Image.new('L',(maxx-minx+1,maxy-miny+1),0)
[?2004l[?2004h>     for x,y in pts: m.putpixel((x-minx,y-miny),255)
[?2004l[?2004h>     return color,m
[?2004l[?2004h> 
[?2004l[?2004h> def exact_iou(a,b):
[?2004l[?2004h>     # resize b to a's size, align top-left
[?2004l[?2004h>     b=b.resize(a.size,Image.LANCZOS)
[?2004l[?2004h>     pa=list(a.getdata()); pb=list(b.getdata())
[?2004l[?2004h>     inter=sum(1 for x,y in zip(pa,pb) if x>100 and y>100)
[?2004l[?2004h>     union=sum(1 for x,y in zip(pa,pb) if x>100 or y>100)
[?2004l[?2004h>     return inter/union if union else 0
[?2004l[?2004h> 
[?2004l[?2004h> for name in ['b7','a8','e6','c8','d8','f5','g5','e5','b2','c1','c3','e1','e2','a1']:
[?2004l[?2004h>     color,om=obs_mask(name)
[?2004l[?2004h>     chars=black_chars if color=='B' else white_chars
[?2004l[?2004h>     scores=[]
[?2004l[?2004h>     for sym,ch in chars.items():
[?2004l[?2004h>         for size in range(48,61):
