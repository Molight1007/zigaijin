python3 - <<'PY'
from PIL import Image
im=Image.open('chess_board.png').convert('RGB')
BGs=[(240,217,181),(181,136,99)]
def fb(p): return min(sum((p[i]-b[i])**2 for i in range(3)) for b in BGs)>=25**2
print('piece bbox area top1/3 mid1/3 bot1/3 minx maxx miny maxy')
for r in range(8):
    for c in range(8):
        sq=im.crop((c*80,r*80,(c+1)*80,(r+1)*80))
        pts=[]
        for y in range(80):
            for x in range(80):
                if fb(sq.getpixel((x,y))): pts.append((x,y))
        if len(pts)<100: continue
        xs=[p[0] for p in pts]; ys=[p[1] for p in pts]
        def cnt(y0,y1): return sum(y0<=y<y1 for x,y in pts)
        name=chr(ord('a')+c)+str(8-r)
        print(f'{name} {min(xs)},{max(xs)},{min(ys)},{max(ys)} {len(pts):4d} {cnt(0,27):4d} {cnt(27,54):4d} {cnt(54,80):4d}')
PY
5 ...BWBBW
4 ........
3 W.W.....
2 .W..WWW.
1 W.W.W..W
