python3 - <<'PY'
from PIL import Image
im=Image.open('chess_board.png').convert('RGB')
# Print detailed per-square counts for squares with content
for r in range(8):
    for c in range(8):
        sq=im.crop((c*80,r*80,(c+1)*80,(r+1)*80))
        black=sum(1 for p in sq.getdata() if sum(p)<180)
        white=sum(1 for p in sq.getdata() if sum(p)>690)
        if black+white>50:
            print(chr(ord('a')+c)+str(8-r), 'black', black, 'white', white)
