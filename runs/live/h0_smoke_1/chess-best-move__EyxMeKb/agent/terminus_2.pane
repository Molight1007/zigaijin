[?2004l[?2004h> def show(name,S=28,color=None):
[?2004l[?2004h>  c=ord(name[0])-97; r=8-int(name[1]); sq=im.crop((c*80,r*80,(c+1)*80,(r+1)*80))
[?2004l[?2004h>  if color is None:
[?2004l[?2004h>   b=sum(1 for p in sq.getdata() if max(p)<120); w=sum(1 for p in sq.getdata() if min(p)>240); color='B' if b>w else 'W'
[?2004l[?2004h>  pts=[(x,y) for y in range(80) for x in range(80) if (max(sq.getpixel((x,y)))<130 if color=='B' else min(sq.getpixel((x,y)))>225)]
[?2004l[?2004h>  minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)
[?2004l[?2004h>  w=maxx-minx+1; h=maxy-miny+1
[?2004l[?2004h>  print('===',name,color,'bbox',minx,maxx,miny,maxy,'w,h',w,h,'===')
[?2004l[?2004h>  for yy in range(S):
[?2004l[?2004h>   line=''
[?2004l[?2004h>   for xx in range(S):
[?2004l[?2004h>    x0=minx+xx*w//S; x1=minx+(xx+1)*w//S; y0=miny+yy*h//S; y1=miny+(yy+1)*h//S
[?2004l[?2004h>    tot=0; cnt=0
[?2004l[?2004h>    for y in range(y0,y1):
[?2004l[?2004h>     for x in range(x0,x1):
[?2004l[?2004h>      tot+=1
[?2004l[?2004h>      p=sq.getpixel((x,y))
[?2004l[?2004h>      if (max(p)<130 if color=='B' else min(p)>225): cnt+=1
[?2004l[?2004h>    line += '#' if cnt*3>tot else ('+' if cnt*6>tot else ' ')
[?2004l[?2004h>   print(line)
[?2004l[?2004h> white=['a1','h1','c1','e1','c3','e2']
[?2004l[?2004h> for n in white: show(n)
