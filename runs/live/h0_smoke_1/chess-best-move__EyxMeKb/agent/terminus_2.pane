[?2004l[?2004h>             # require near same bbox dims
[?2004l[?2004h>             if abs(gm.width-om.width)<=2 and abs(gm.height-om.height)<=2:
[?2004l[?2004h>                 scores.append((exact_iou(om,gm),sym,size,gm.size))
[?2004l[?2004h>     scores.sort(reverse=True)
