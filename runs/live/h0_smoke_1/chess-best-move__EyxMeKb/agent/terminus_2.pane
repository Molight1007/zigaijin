[?2004l[?2004h> from PIL import Image
[?2004l[?2004h> im=Image.open('chess_board.png').convert('RGB')
[?2004l[?2004h> BGs=[(240,217,181),(181,136,99)]
[?2004l[?2004h> def fb(p): return min(sum((p[i]-b[i])**2 for i in range(3)) for b in BGs)>=20**2
[?2004l[?2004h> def mask_for(name):
[?2004l[?2004h>     c=ord(name[0])-97; r=8-int(name[1])
[?2004l[?2004h>     sq=im.crop((c*80,r*80,(c+1)*80,(r+1)*80))
[?2004l[?2004h>     pts=[(x,y) for y in range(80) for x in range(80) if fb(sq.getpixel((x,y)))]
[?2004l[?2004h>     minx=min(x for x,y in pts); maxx=max(x for x,y in pts); miny=min(y for x,y in pts); maxy=max(y for x,y in pts)
[?2004l[?2004h>     w=maxx-minx+1; h=maxy-miny+1; S=18
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for yy in range(S):
[?2004l[?2004h>         line=''
[?2004l[?2004h>         for xx in range(S):
[?2004l[?2004h>             x0=minx+xx*w//S; x1=minx+(xx+1)*w//S; y0=miny+yy*h//S; y1=miny+(yy+1)*h//S
[?2004l[?2004h>             tot=0; cnt=0
[?2004l[?2004h>             for y in range(y0,y1):
[?2004l[?2004h>                 for x in range(x0,x1):
[?2004l[?2004h>                     tot+=1
[?2004l[?2004h>                     if fb(sq.getpixel((x,y))): cnt+=1
[?2004l[?2004h>             line += '#' if cnt*2>tot else ' '
[?2004l[?2004h>         out.append(line)
[?2004l[?2004h>     return out
[?2004l[?2004h> black=['a8','c8','d8','f8','b7','f7','g7','a6','c6','e6','d5','f5','g5']
[?2004l[?2004h> white=['e5','h5','a3','c3','b2','e2','f2','g2','a1','c1','e1','h1']
[?2004l[?2004h> for color,names in [('BLACK',black),('WHITE',white)]:
